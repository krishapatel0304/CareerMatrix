PORT=5000
 
# Production Database (Supabase / Render) - Session Pooler port 5432
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/[database]

# Local PostgreSQL Fallback
DB_USER=postgres
DB_HOST=localhost
DB_NAME=careermatrix
DB_PASSWORD=your_password_here
DB_PORT=5432

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key_here

